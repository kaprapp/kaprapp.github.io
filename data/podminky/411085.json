{"c":"411085","n":"SMÍCHOVSKÝ POTOK 1","t":"M","s":"STČ","o":"Sloveč","url":"411085-smichovsky-potok-1","stav":"2026-10-10","popis":"Přítok Štítarského potoka – Mrliny – Labe. Od můstku silnice Nouzov–Budčeves až k pramenům.\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\nNejmenší lovná míra štiky je stanovena na 55 cm, lína na 25 cm, candáta na 50 cm a amura na 65 cm. Lov přívlačí je povolen od 1. 9. Při ponechání si 2 ks vyjmenovaných ryb uvedených v § 16 odst. 2 vyhlášky č. 197/2004 Sb. v platném znění, končí denní lov, i když nebylo dosaženo denního limitu 7 kg ulovených ryb. Kapr nad 65 cm (včetně) se musí bez prodlení a s maximální šetrností vrátit zpět do rybářského revíru, kde byl uloven. Místa pro handicapované rybáře jsou vyznačena tabulemi.","delka":14,"rozloha":4,"lat":50.266747,"lon":15.302681,"mo_web":"https://www.rybsvaz.cz/mo/-/slovec","mo_tel":"721662080","mo_mail":"crsmoslovec@gmail.com","doba":[{"od":"2026-10-01","do":"2026-12-31","h":"05:00–22:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":65,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Bolen dravý","min":40,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Candát obecný","min":50,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-12-31","pozn":""},{"d":"Jelec jesen","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":25,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Kapr obecný","min":40,"max":65,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Lín obecný","min":25,"max":null,"hajen":false,"od":"2026-