{"c":"411086","n":"STROUPINSKÝ POTOK (PEKELSKÝ) 2","t":"M","s":"STČ","o":"Žebrák","url":"411086-stroupinsky-potok-pekelsky-2","stav":"2026-10-11","popis":"Přítok Berounky. Revír tvoří nádrž na Pekelském potoce (přítok Stroupinského potoka)\t\t\t\t\t\t\t\t\t\t\r\nPeklo\tv k. ú. Točník\t2,7 ha\t\t\t\t\t\t\t\t\r\n(GPS 49°53'18.934\"N, 13°52'37.893\"E)\t\t\t\t\t\t\t\t\t\t\r\nNejmenší lovná míra štiky je stanovena na 60 cm, lína na 30 cm, kapra na 45 cm a amura na 60 cm. Denní úlovek lína je omezen max. na 2 ks. Ponechá- li si rybář v den lovu 2 ks vyjmenovaných ryb, a to kapr, amur, candát, štika nebo jejich kombinace, končí pro něj v revíru denní rybolov, i když nebylo dosaženo denního limitu 7 kg ulovených ryb. Lov ryb v prostoru rákosin je zakázán (vyznačeno tabulemi), lov ryb z hráze je zakázán.","delka":0,"rozloha":2,"lat":49.88835,"lon":13.875372,"mo_web":"https://www.rybsvaz.cz/mo/-/zebrak","mo_tel":"+420732 633 435","mo_mail":"zebrak@mocrs.cz","doba":[{"od":"2026-10-01","do":"2026-12-31","h":"05:00–22:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":60,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Bolen dravý","min":40,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Candát obecný","min":45,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-12-31","pozn":""},{"d":"Jelec jesen","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":25,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Kapr obecný","min":45,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Lín obecný","min":30,