{"c":"413013","n":"KAČÁK 2","t":"P","s":"STČ","o":"Kladno","url":"413013-kacak-2","stav":"2026-10-03","popis":"**Z důvodů nízkého průtoku je s okamžitou platností uzavřen revír do odvolání.**\nPřítok Berounky. Od jezu v Chrustenicích až k jezu koupaliště Okrouhlík (Dědkův mlýn). Přítoky jsou chovné – lov ryb zakázán. Na revíru je zakázáno brodění v době od 1. 9. do 30. 11. a zákaz lovu přívlačí od 1. 9. do 30.11.","delka":12,"rozloha":4,"lat":50.034281,"lon":14.125372,"mo_web":"https://www.rybsvaz.cz/mo/-/kladno","mo_tel":"","mo_mail":"info@rybarikladno.cz","doba":[{"od":"2026-10-01","do":"2026-10-31","h":"07:00–19:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Bolen dravý","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Candát obecný","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-11-30","pozn":""},{"d":"Jelec jesen","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Kapr obecný","min":40,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lipan podhorní","min":40,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-11-30","pozn":""},{"d":"Losos obecný","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Mník jednovousý","min":null,"max":null,"hajen":true,"od":"2026-01-0