{"c":"413018","n":"MASTNÍK 2","t":"P","s":"STČ","o":"Sedlčany","url":"413018-mastnik-2","stav":"2026-10-09","popis":"Přítok Vltavy. Od jezu rybníka v Červeném Hrádku až k nádrži Velký Mastník v k. ú. Martinice. K revíru patří úsek potoka od hraničních tabulí nad vtokem Mastníku do ÚN Slapy u Rákosníkova mlýna k hraničním tabulím v obci Radič. Dále k revíru patří potok Křečovický a Vlkonický od soutoku s Mastníkem až k hraničním tabulím, které označují chovnou část potoků. Přítoky jsou chovné – lov ryb zakázán. Rybář smí lovit a přivlastňovat si ryby lososovité nejvýše tři dny v kalendářním v týdnu. Před zahájením lovu lososovitých ryb musí rybář zakroužkovat datum lovu. Lov na háčky s protihroty povolen.","delka":15,"rozloha":7,"lat":49.679753,"lon":14.492475,"mo_web":"http://www.rybari-sedlcany.cz","mo_tel":"777 719 416","mo_mail":"mo@rybari-sedlcany.cz","doba":[{"od":"2026-10-01","do":"2026-10-31","h":"07:00–19:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Bolen dravý","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Candát obecný","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-11-30","pozn":""},{"d":"Jelec jesen","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Kapr obecný","min":40,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-04-16","do