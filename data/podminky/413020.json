hmotnost zapisuje po skončení nebo přerušení lovu před odchodem od vody."],"lov":[{"co":"lov pod ledem","zakaz":true,"od":"2026-01-01","do":"2026-12-31"},{"co":"lov ryb","zakaz":false,"od":"2026-04-16","do":"2026-11-30"},{"co":"lov z plavidla","zakaz":true,"od":"2026-01-01","do":"2026-12-31"},{"co":"používání háčku s protihrotem","zakaz":true,"od":"2026-04-16","do":"2026-11-30"}],"technika":[{"co":"Čeřínkování","zakaz":true},{"co":"Hlubinná přívlač","zakaz":true},{"co":"Muškaření","zakaz":false},{"co":"Plavaná","zakaz":false},{"co":"Položená","zakaz":false},{"co":"Přívlač","zakaz":true}]}