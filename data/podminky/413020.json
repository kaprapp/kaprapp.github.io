{"c":"413020","n":"MOHELKA 1","t":"P","s":"STČ","o":"Mnichovo Hradiště","url":"413020-mohelka-1","stav":"2026-10-10","popis":"Přítok Jizery. Od jezu u obce Chlístov až po ústí u obce Mohelnice nad Jizerou. Přítoky chovné – lov ryb zde zakázán. Zákaz lovu ryb v náhonu vodní elektrárny Chocnějovice, od této vodní elektrárny (GPS 50°34'33.7\"N, 14°57'53.6\"E) až k předchozímu jezu (GPS 50°34'44.5\"N, 14°57'42.3\"E).\r\nNejmenší lovná míra pstruha obecného stanovena na 30 cm. Na revíru povoleno použití pouze jednoho jednoháčku.","delka":8,"rozloha":3,"lat":50.572922,"lon":14.968686,"mo_web":"https://www.rybarimh.cz","mo_tel":"723 769 164","mo_mail":"jednatel@rybarimh.cz","doba":[{"od":"2026-10-01","do":"2026-10-31","h":"07:00–19:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Bolen dravý","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Candát obecný","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-11-30","pozn":""},{"d":"Jelec jesen","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Kapr obecný","min":40,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lipan podhorní","min":40,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-11-30","pozn":""},{"d":"Losos obecný","min":null,"max":null,"hajen":true,"od":"20