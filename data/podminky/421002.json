{"c":"421002","n":"BEZDREVSKÝ POTOK 2","t":"M","s":"JČ","o":"Netolice","url":"421002-bezdrevsky-potok-2","stav":"2026-10-04","popis":"Od nového jezu nad Soudnou tůní pod obcí Sedlec až k soutoku s Třebanickým potokem.\t\t\t\t\t\t\t\t\t\t\r\nTřebanický potok nepatří do revíru. K revíru patří nádrže:\t\t\t\t\t\t\t\t\t\t\r\nMnich\tv k. ú. Netolice\t11 ha\t\t\t\t\t\t\t\t\r\n(GPS 49°2'49.73\"N, 14°11'44.555\"E)\t\t\t\t\t\t\t\t\t\t\r\nrybník Molerovský\tNetolice\t1,3 ha\t\t\t\t\t\t\t\t\r\n(GPS 49°2'54.254\"N, 14°12'24.019\"E)\t\t\t\t\t\t\t\t\t\t\r\nV přítokové části rybníka Mnich je vyhlášena celoročně CHRO, v terénu označena cedulemi a bójí. Na celém rybníku platí zákaz brodění.\t\t\t\t\t\t\t\t\t\t\r\nNa rybníku Molerovský platí pouze zvláštní místní povolenky. Na revíru je vhodné místo pro handicapované rybáře (GPS 49°2'42.373\"N, 14°11'30.838\"E).","delka":11,"rozloha":17,"lat":49.062289,"lon":14.243836,"mo_web":"https://www.rybsvaz.cz/mo/-/netolice","mo_tel":"","mo_mail":"netolice@mo.jcus.cz","doba":[{"od":"2026-10-01","do":"2026-12-31","h":"05:00–22:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Bolen dravý","min":40,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Candát obecný","min":45,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-12-31","pozn":""},{"d":"Jelec jesen","min":25,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":25,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Kapr obecný","min":40,"max":70,"hajen":false,"od":"2026-01-01","do":"2026-12-3