a všech mimopstruho- vých revírech JčÚS na 20 ks ročně na 1 povolenku."],"lov":[{"co":"lov pod ledem","zakaz":true,"od":"2026-01-01","do":"2026-12-31"},{"co":"lov ryb","zakaz":false,"od":"2026-01-01","do":"2026-12-31"},{"co":"lov z plavidla","zakaz":true,"od":"2026-01-01","do":"2026-12-31"}],"technika":[{"co":"Čeřínkování","zakaz":false},{"co":"Muškaření","zakaz":false},{"co":"Plavaná","zakaz":false},{"co":"Položená","zakaz":false},{"co":"Přívlač","zakaz":false}]}