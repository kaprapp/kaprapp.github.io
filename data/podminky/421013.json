{"c":"421013","n":"ČERNOVICKÝ POTOK 1","t":"M","s":"JČ","o":"Soběslav","url":"421013-cernovicky-potok-1","stav":"2026-10-04","popis":"Přítok Lužnice. Od ústí do Lužnice v Soběslavi až k hrázi rybníka Zmrhal u Dvorců v k. ú. Tučapy. Rybníky na toku do revíru nepatří. Zákaz lovu na udici je v úseku od ústí do Lužnice až po jez u sádek Rybářství Třeboň,\t\t\t\t\t\t\t\t\t\t\r\na. s., v Soběslavi – CHRO. Zákaz používání streamerů v období od 1. 1. do 15. 6.","delka":9,"rozloha":12,"lat":49.274325,"lon":14.745222,"mo_web":"https://www.rybsvaz.cz/mo/-/sobeslav","mo_tel":"","mo_mail":"sobeslav@mo.jcus.cz","doba":[{"od":"2026-10-01","do":"2026-12-31","h":"05:00–22:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Bolen dravý","min":40,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Candát obecný","min":45,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-12-31","pozn":""},{"d":"Jelec jesen","min":25,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":25,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Kapr obecný","min":40,"max":70,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Lipan podhorní","min":40,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-11-30","pozn":""},{"d":"Losos obecný","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Mník jednovousý","min":30,"max":null,"hajen":false,"od":"2026-03-16","do":"20