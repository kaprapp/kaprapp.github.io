{"c":"421020","n":"HAMERSKÝ POTOK 1 A","t":"M","s":"JČ","o":"Jindřichův Hradec","url":"421020-hamersky-potok-1-a","stav":"2026-10-07","popis":"Přítok Nežárky. Rybářský revír tvoří nádrž Vajgar (GPS 49°8'35.537\"N, 15°1'2.589\"E) v Jindřichově Hradci až k jezu továrny Jitka v Otíně. Lov z plavidel je povolen. Kotvení plavidel povoleno 30 m od leknínových polí a 50 m od břehu. Nahazování do leknínových polí a jejich poškozování je zakázáno. Zákaz lovu ryb z oplocených pozemků. Nejmenší lovná míra kapra zvýšena na 45 cm.","delka":3,"rozloha":53,"lat":49.145417,"lon":15.021403,"mo_web":"https://www.rybsvaz.cz/mo/-/jindrichuv-hradec","mo_tel":"","mo_mail":"jhradec@mo.jcus.cz","doba":[{"od":"2026-10-01","do":"2026-12-31","h":"05:00–22:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Bolen dravý","min":40,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Candát obecný","min":45,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-12-31","pozn":""},{"d":"Jelec jesen","min":25,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":25,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Kapr obecný","min":45,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Lipan podhorní","min":40,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-11-30","pozn":""},{"d":"Losos obecný","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"