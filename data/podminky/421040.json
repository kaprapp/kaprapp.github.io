{"c":"421040","n":"LUŽNICE 8","t":"M","s":"JČ","o":"Veselí nad Lužnicí","url":"421040-luznice-8","stav":"2026-10-03","popis":"Přítok Vltavy. Od silničního mostu ve Vlkově až ke konci oplocení sádek Rybářství Třeboň, a. s. Úsek podél oplocení sádek až k výtoku z rybníka Rožmberk je v držbě Rybářství Třeboň, a. s. – lov ryb zakázán. Potok Říčky (GPS Z: 49°6'21.336\"N, 14°44'21.025\"E, K: 49°4'7.234\"N, 14°42'55.647\"E)\t\t\t\t\t\t\t\t\t\t\nod vtoku do Lužnice až po sádky Šaloun (k. ú. Lomnice nad Lužnicí) je součástí revíru. Do revíru nepatří Zlatá stoka a spojky rybníků včetně úseku od jalového přepadu z rybníka Rožmberk až k ústí odpadu Adolfky.","delka":13,"rozloha":25,"lat":49.098531,"lon":14.739903,"mo_web":"https://www.rybsvaz.cz/mo/-/veseli-nad-luznici","mo_tel":"","mo_mail":"veseli@mo.jcus.cz","doba":[{"od":"2026-10-01","do":"2026-12-31","h":"05:00–22:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Bolen dravý","min":40,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Candát obecný","min":45,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-12-31","pozn":""},{"d":"Jelec jesen","min":25,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":25,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Kapr obecný","min":40,"max":70,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Lipan podhorní","min":40,"max":null,"hajen":false,"od":"2026-06-16","do":"20