{"c":"421077","n":"ČERNOVICKÝ POTOK 4","t":"M","s":"JČ","o":"Kamenice nad Lipou","url":"421077-cernovicky-potok-4","stav":"2026-10-03","popis":"Přítok Lužnice. Revír tvoří nádrž:\t\t\t\t\t\t\t\t\t\t\nKlínot\tv k. ú. Černovice\t1,43 ha\t\t\t\t\t\t\t\t\n(GPS 49°22'46.46\"N, 14°57'53.639\"E)\t\t\t\t\t\t\t\t\t\t\nNa nádrži Klínot platí v červenci a srpnu zákaz lovu ryb v prostoru turistického zařízení – vyznačeno tabulemi. Jelec jesen a mník jednovousý jsou celoročně hájeni. Nejmenší lovná míra kapra zvýšena na 45 cm.","delka":0,"rozloha":1,"lat":49.380167,"lon":14.965933,"mo_web":"https://www.rybsvaz.cz/mo/-/kamenice-nad-lipou","mo_tel":"","mo_mail":"kamenice@mo.jcus.cz","doba":[{"od":"2026-10-01","do":"2026-12-31","h":"05:00–22:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Bolen dravý","min":40,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Candát obecný","min":45,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-12-31","pozn":""},{"d":"Jelec jesen","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":25,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Kapr obecný","min":45,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Lipan podhorní","min":40,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-11-30","pozn":""},{"d":"Losos obecný","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Mn