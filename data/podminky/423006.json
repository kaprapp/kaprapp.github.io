{"c":"423006","n":"BLANICE VODŇANSKÁ 7","t":"P","s":"JČ","o":"Husinec","url":"423006-blanice-vodnanska-7","stav":"2026-10-11","popis":"Přítok Otavy. Od konce maximálního vzdutí ÚN Husinec v místech pod dětským táborem (Rechle) až k železničnímu mostu zastávky Spálenec. Zde začíná CHRO, kde je zakázán lov ryb. Od Blanického mlýna k zastávce ČD Spálenec platí zákaz vstupu do vody (brodění). V úseku od silničního mostu u obce Řepešín (GPS: 48°59‘45.362“N, 13°54‘49.866“E) po začátek revíru u železničního mostu zastávky Spálenec (GPS: 48°55‘39.487“N, 13°58‘11.708“E) platí v období od 1. 9. do 30. 11. zákaz rybolovu. Nejmenší lovná míra pstruha obecného je zvýšena na 40 cm.","delka":20,"rozloha":12,"lat":48.982158,"lon":13.942903,"mo_web":"http://www.crsmohusinec.cz/","mo_tel":"","mo_mail":"vfrajman@seznam.cz","doba":[{"od":"2026-10-01","do":"2026-10-31","h":"07:00–19:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Bolen dravý","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Candát obecný","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-11-30","pozn":""},{"d":"Jelec jesen","min":25,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Kapr obecný","min":40,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lipan podhorní","min"