{"c":"423007","n":"BRLOŽSKÝ POTOK 1","t":"P","s":"JČ","o":"Křemže","url":"423007-brlozsky-potok-1","stav":"2026-10-06","popis":"Přítok Vltavy. Od ústí do Vltavy u Třísova až k hrázi Ktišské nádrže, včetně nádrže u Dívčího Kamene (GPS 48°53'22.333\"N, 14°21'6.534\"E) – 0,5 ha. Lov na plavanou a položenou je povolen pouze na nádrži Dívčí Kámen, a to pouze od 1. 7. do 31. 8. (včetně). Dále je zákaz rybolovu nad obcí Brloh, a to od mostku pily v Brlohu až k hrázi Ktišské nádrže. V úseku od Červeného Mlýna (GPS: 48°55‘7.368“N, 14°16‘18.665“E) po most pily v Brlohu (GPS: 48°55‘36.611“N, 14°12‘20.829“E) platí v období od 1. 9. do 30. 11. zákaz rybolovu.","delka":22,"rozloha":10,"lat":48.909622,"lon":14.245453,"mo_web":"https://www.rybsvaz.cz/mo/-/kremze","mo_tel":"","mo_mail":"kremze@mo.jcus.cz","doba":[{"od":"2026-10-01","do":"2026-10-31","h":"07:00–19:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Bolen dravý","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Candát obecný","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-11-30","pozn":""},{"d":"Jelec jesen","min":25,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Kapr obecný","min":40,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lipan podhorní","min":40,"max":null,"