{"c":"423016","n":"DRAČICE 1","t":"P","s":"JČ","o":"Nová Bystřice","url":"423016-dracice-1","stav":"2026-10-04","popis":"Od soutoku s Lužnicí až k hrázi rybníka Osika v k. ú. Albeř, kromě úseku protékajícího Rakouskem. Jelec jesen a mník jednovousý jsou celoročně hájeni. Úsek od mostu v obci Františkov (GPS: 48°53‘35.298“N, 14°56‘15.611“E) až po státní Hranici s Rakouskem (GPS: 48°53‘44.325“N, 14°59‘14.284“E) je chráněnou rybí oblastí – lov ryb udicí zakázán. \nRybníky Mnišský, a Novobystřický do revíru nepatří.","delka":18,"rozloha":5,"lat":48.960236,"lon":15.018542,"mo_web":"https://www.rybsvaz.cz/mo/-/nova-bystrice","mo_tel":"724329616","mo_mail":"crs.novabystrice@seznam.cz","doba":[{"od":"2026-10-01","do":"2026-10-31","h":"07:00–19:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Bolen dravý","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Candát obecný","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-11-30","pozn":""},{"d":"Jelec jesen","min":25,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Kapr obecný","min":40,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lipan podhorní","min":40,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-11-30","pozn":""},{"d":"Losos obecný","min":null,"max":null,"hajen":tru