{"c":"423018","n":"JÍLECKÝ POTOK 1","t":"P","s":"JČ","o":"České Budějovice 1","url":"423018-jilecky-potok-1","stav":"2026-10-10","popis":"Přítok Vltavy. Od ústí do Vltavy až k pramenům, t. j. k pramenům potoků Jíleckého, Zubčického a Mirkovického.\nZákaz lovu ryb na Jíleckém potoku od silničního mostu pod obcí Mirkovice (GPS 48°48'42.309\"N, 14°23'38.253\"E) až k pramenům. Zákaz lovu ryb na Mirkovickém potoku. Na celém revíru platí v období od 1. 9. do 30. 11. zákaz rybolovu. Zubčický potok je chráněnou rybí oblastí – lov ryb udicí zakázán.","delka":13,"rozloha":3,"lat":48.78985,"lon":14.398769,"mo_web":"","mo_tel":"+420 736 447 950","mo_mail":"","doba":[{"od":"2026-10-01","do":"2026-10-31","h":"07:00–19:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Bolen dravý","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Candát obecný","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-11-30","pozn":""},{"d":"Jelec jesen","min":25,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Kapr obecný","min":40,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lipan podhorní","min":40,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-11-30","pozn":""},{"d":"Losos obecný","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-1