{"c":"423021","n":"KAMENIČKA 2 P","t":"P","s":"JČ","o":"Kamenice nad Lipou","url":"423021-kamenicka-2-p","stav":"2026-10-10","popis":"Přítok Nežárky – Lužnice. Od jezu Vrzákova mlýna nad obcí Žďár až k rybníku Zámecký. Všechny přítoky a pramenná část nad rybníkem Kalich a Zámecký jsou chovné – lov ryb zakázán. Rybníky Zámecký, Dvouhrázný a Pecovský do revíru nepatří. Jelec jesen a mník jednovousý jsou celoročně hájeni.","delka":9,"rozloha":2,"lat":49.282306,"lon":15.081061,"mo_web":"https://www.rybsvaz.cz/mo/-/kamenice-nad-lipou","mo_tel":"","mo_mail":"kamenice@mo.jcus.cz","doba":[{"od":"2026-10-01","do":"2026-10-31","h":"07:00–19:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Bolen dravý","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Candát obecný","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-11-30","pozn":""},{"d":"Jelec jesen","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Kapr obecný","min":40,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lipan podhorní","min":40,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-11-30","pozn":""},{"d":"Losos obecný","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Mník jednovousý","min":null,"max":null,"hajen":true