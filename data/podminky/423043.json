{"c":"423043","n":"VLTAVA 34 P","t":"P","s":"JČ","o":"Lenora","url":"423043-vltava-34-p","stav":"2026-10-05","popis":"Od jízku pod krytou Rechlí pod Lenorou až k můstku přes Vltavu v Polce, včetně náhonu k objektu bývalé sklárny v Lenoře. K revíru patří:\nDolní nádrž (včetně náhonu) v k. ú. Polka\t2 ha \nV úseku od mostku u Polecké elektrárny až k můstku do Polky (Staré koryto) platí celoroční zákaz lovu ryb. Míra pstruha obecného zvýšena na 40 cm. Jelec jesen a mník jednovousý jsou celoročně hájeni.","delka":15,"rozloha":13,"lat":48.938669,"lon":13.7605,"mo_web":"https://www.rybsvaz.cz/mo/-/lenora","mo_tel":"","mo_mail":"lenora@mo.jcus.cz","doba":[{"od":"2026-10-01","do":"2026-10-31","h":"07:00–19:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Bolen dravý","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Candát obecný","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-11-30","pozn":""},{"d":"Jelec jesen","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Kapr obecný","min":40,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lipan podhorní","min":40,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-11-30","pozn":""},{"d":"Losos obecný","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31"