{"c":"431001","n":"BEROUNKA 7","t":"M","s":"ZČ","o":"Radnice","url":"431001-berounka-7","stav":"2026-10-08","popis":"GPS Z: 49°57'32.665\"N, 13°41'34.849\"E, K: 49°56'12.63\"N, 13°35'22.478\"E\nPřítok Vltavy. Od jezu mlýna ve Zvíkovci (ř. km 80,6) až k jezu mlýna Krašov v k. ú. Bohy (ř. km 93,3), mimo potoky Všehrdský a Radubický. Potoky Všehrdský a Radubický jsou chovné – lov ryb zakázán. V úseku cca 50 m na pravém břehu nad jezem mlýna s MVE ve Zvíkovci je lov ryb zakázán – vyznačeno tabulemi. Průchod objektem MVE je zakázán. Lov z plavidel povolen.","delka":13,"rozloha":45,"lat":49.947531,"lon":13.639475,"mo_web":"https://www.rybsvaz.cz/mo/-/radnice","mo_tel":"603 468 937","mo_mail":"crsradnice@seznam.cz","doba":[{"od":"2026-10-01","do":"2026-12-31","h":"05:00–22:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Bolen dravý","min":40,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Candát obecný","min":45,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-12-31","pozn":""},{"d":"Jelec jesen","min":25,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":25,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Kapr obecný","min":40,"max":70,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Lipan podhorní","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-11-30","pozn":""},{"d":"Losos obecný","min":null,"max":null,"hajen":true,"od":"2026-01-01"