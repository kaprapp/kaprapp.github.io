{"c":"431010","n":"HOLOUBKOVSKÝ POTOK 2","t":"M","s":"ZČ","o":"Holoubkov","url":"431010-holoubkovsky-potok-2","stav":"2026-10-05","popis":"GPS Z: 49°46'0.857\"N, 13°41'15.409\"E, K: 49°47'5.378\"N, 13°43'36.274\"E\nPřítok Berounky. Holoubkovský potok od vtoku do Lomackého (Hamerského) rybníka (ř. km 8,9) až k pramenům. Od Podmýtského rybníka (ř. km 13,5) až k pramenům je potok chráněnou rybí oblastí – lov ryb zakázán. Rybníky Lomacký (Hamerský), Podmýtský, Štěpánský, Hluboký a Holoubkovský do revíru nepatří.","delka":4,"rozloha":1,"lat":49.775867,"lon":13.707178,"mo_web":"https://www.rybsvaz.cz/mo/-/holoubkov","mo_tel":"737 076 219","mo_mail":"crsmo.holoubkov@seznam.cz","doba":[{"od":"2026-10-01","do":"2026-12-31","h":"05:00–22:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Bolen dravý","min":40,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Candát obecný","min":45,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-12-31","pozn":""},{"d":"Jelec jesen","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":25,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Kapr obecný","min":40,"max":70,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Lipan podhorní","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-11-30","pozn":""},{"d":"Losos obecný","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Mn