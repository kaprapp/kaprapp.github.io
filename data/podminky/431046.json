{"c":"431046","n":"RADBUZA 3","t":"M","s":"ZČ","o":"Stod","url":"431046-radbuza-3","stav":"2026-10-11","popis":"GPS Z: 49°39'27.264\"N, 13°15'12.06\"E, K: 49°37'59.45\"N, 13°7'9.086\"E\nPřítok Berounky. Od jezu ve Vodním Újezdě (ř. km 26,7) až k jezu v Hradci u Stodu (ř. km 39,9). V obecném zájmu je zakázán lov ryb z obou břehů náhonu v Chotěšově v úseku 300 m od mostu proti proudu.","delka":15,"rozloha":19,"lat":49.644831,"lon":13.186269,"mo_web":"https://www.rybsvaz.cz/mo/-/stod","mo_tel":"606 7659 067","mo_mail":"crsstod@email.cz","doba":[{"od":"2026-10-01","do":"2026-12-31","h":"05:00–22:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Bolen dravý","min":40,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Candát obecný","min":45,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-12-31","pozn":""},{"d":"Jelec jesen","min":25,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":25,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Kapr obecný","min":40,"max":70,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Lipan podhorní","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-11-30","pozn":""},{"d":"Losos obecný","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Mník jednovousý","min":30,"max":null,"hajen":false,"od":"2026-03-16","do":"2026-12-31","pozn":""},{"d":"Ostroretka stěhovavá","min":30,"max":n