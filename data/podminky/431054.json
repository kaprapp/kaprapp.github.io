{"c":"431054","n":"STARÝ POTOK 1","t":"M","s":"ZČ","o":"Kdyně","url":"431054-stary-potok-1","stav":"2026-10-10","popis":"GPS Z: 49°27'12.03\"N, 12°59'48.439\"E, K: 49°21'40.008\"N, 13°4'5.516\"E\nPřítok Zubřiny. Revír tvoří Záhořanský (Starý) potok od ústí do Zubřiny u Radonic (ř. km 17,9) až k pramenům. Nádrž Bílka (Novodvorský rybník) tvoří samostatný revír. Lov ryb je zakázán v úseku 50 m pod hrází nádrže Bílka v k. ú. Kout a v úseku na pravém břehu (ve směru toku) mezi silničními mosty v obci Zahořany a ve slepém rameni nad nádrží Bílka v délce 400 m.","delka":13,"rozloha":2,"lat":49.407228,"lon":13.030169,"mo_web":"https://www.rybsvaz.cz/mo/-/kdyne","mo_tel":"+420 606 531 782","mo_mail":"rybarikdyne@seznam.cz","doba":[{"od":"2026-10-01","do":"2026-12-31","h":"05:00–22:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Bolen dravý","min":40,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Candát obecný","min":45,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-12-31","pozn":""},{"d":"Jelec jesen","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":25,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Kapr obecný","min":40,"max":70,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Lipan podhorní","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-11-30","pozn":""},{"d":"Losos obecný","min":null,"max":null,"hajen":true,"od":"202