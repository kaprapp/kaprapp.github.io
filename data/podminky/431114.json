{"c":"431114","n":"TŘEMOŠENKA 1/R","t":"M","s":"ZČ","o":"Třemošná","url":"431114-tremosenka-1-r","stav":"2026-10-05","popis":"Revír tvoří nádrže:\t\t\t\t\t\t\t\t\t\t\r\nPR 01 Hroznata\tv k. ú. Podmokly\t4 ha\t\t\t\t\t\t\t\t\r\n    PR 02 Rybník\tČeská Bříza\t0,8 ha Zákaz vjezdu motorových vozidel na louku při pravém břehu rybníka Hroznata (soukromý pozemek). Chráněná rybí oblast je na rybníku Hroznata u přítoku v délce 70 m od původního vtoku směrem k příjezdové komunikaci – vyznačeno tabulemi – lov ryb zakázán. Přítoky jsou chovné – lov ryb zakázán. Horní část Třemošenky a potoka Bělá od uvedených hranic až k pramenům jsou pstruhové revíry.","delka":0,"rozloha":4,"lat":null,"lon":null,"mo_web":"https://www.rybsvaz.cz/mo/-/tremosna","mo_tel":"606 430 403","mo_mail":"crs.tremosna@centrum.cz","doba":[{"od":"2026-10-01","do":"2026-12-31","h":"05:00–22:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Bolen dravý","min":40,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Candát obecný","min":45,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-12-31","pozn":""},{"d":"Jelec jesen","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":25,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-12-31","pozn":""},{"d":"Kapr obecný","min":40,"max":70,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Lipan podhorní","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-11-30"