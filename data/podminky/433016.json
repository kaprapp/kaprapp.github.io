{"c":"433016","n":"KOSOVÝ POTOK 2","t":"P","s":"ZČ","o":"Mariánské Lázně","url":"433016-kosovy-potok-2","stav":"2026-10-10","popis":"GPS Z: 49°54'2.823\"N, 12°47'3.333\"E, K: 49°58'33.365\"N, 12°35'43.764\"E\nPřítok Mže. Od silničního mostu v Michalových Horách (ř. km 16,2) až k pramenům. Od jezu v Jedlové (ř. km 38,3) až k pramenům a všechny přítoky jsou chovné – lov ryb zakázán. Lov na mrtvou rybku nad 15 cm je povolen.","delka":23,"rozloha":10,"lat":49.938461,"lon":12.692222,"mo_web":"https://www.rybsvaz.cz/mo/-/marianske-lazne","mo_tel":"","mo_mail":"crsmarianskelazne@seznam.cz","doba":[{"od":"2026-10-01","do":"2026-10-31","h":"07:00–19:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Bolen dravý","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Candát obecný","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-11-30","pozn":""},{"d":"Jelec jesen","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Kapr obecný","min":40,"max":70,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lipan podhorní","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-11-30","pozn":""},{"d":"Losos obecný","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Mník jednovousý","min":null,"max":null,"haj