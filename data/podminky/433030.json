{"c":"433030","n":"ODRAVA 1","t":"P","s":"ZČ","o":"Kynšperk nad Ohří","url":"433030-odrava-1","stav":"2026-10-06","popis":"GPS Z: 50°6'37.693\"N, 12°29'6.687\"E, K: 50°5'6.883\"N, 12°28'37.269\"E\nPřítok Ohře. Od ústí do Ohře (ř. km 224,1) až k patě hráze údolní nádrže Jesenice (ř. km 4). V obecném zájmu je zákaz lovu ryb v prostoru pod hrází údolní nádrže Jesenice od středního sloupu až k patě hráze. Lov na mrtvou rybku povolen.","delka":5,"rozloha":2,"lat":50.097858,"lon":12.479789,"mo_web":"https://www.rybsvaz.cz/mo/-/kynsperk-nad-ohri","mo_tel":"608 602 808","mo_mail":"","doba":[{"od":"2026-10-01","do":"2026-10-31","h":"07:00–19:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Bolen dravý","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Candát obecný","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-11-30","pozn":""},{"d":"Jelec jesen","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Kapr obecný","min":40,"max":70,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lipan podhorní","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-11-30","pozn":""},{"d":"Losos obecný","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Mník jednovousý","min":null,"max":null,"hajen":true