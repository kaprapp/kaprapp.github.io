{"c":"433040","n":"ROLAVA 2","t":"P","s":"ZČ","o":"Božičany","url":"433040-rolava-2","stav":"2026-10-07","popis":"GPS Z: 50°19'15.27\"N, 12°44'3.706\"E, K: 50°23'57.731\"N, 12°36'50.593\"E\nPřítok Ohře. Od ústí Nejdeckého potoka (Rodišovky) v Nejdku (ř. km 16,4) až k pramenům se všemi přítoky včetně Nejdeckého potoka. Lov ryb je zakázán v areálu Nejdeckých česáren. Potoky Nejdecký a Rudenský jsou chovné – lov ryb zakázán. Nádrž Bernov tvoří samostatný mimopstruhový revír.","delka":25,"rozloha":7,"lat":50.360139,"lon":12.666156,"mo_web":"https://www.rybsvaz.cz/mo/-/bozicany","mo_tel":"724606830","mo_mail":"d.pechousek@seznam.cz","doba":[{"od":"2026-10-01","do":"2026-10-31","h":"07:00–19:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Bolen dravý","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Candát obecný","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-11-30","pozn":""},{"d":"Jelec jesen","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Kapr obecný","min":40,"max":70,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lipan podhorní","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-11-30","pozn":""},{"d":"Losos obecný","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d