{"c":"433041","n":"ŘEZENSKÝ POTOK 1","t":"P","s":"ZČ","o":"Nýrsko","url":"433041-rezensky-potok-1","stav":"2026-10-10","popis":"GPS Z: 49°7'20.597\"N, 13°12'19.273\"E, K: 49°9'32.994\"N, 13°15'40.576\"E\nPřítok Dunaje (Čertovo jezero). Řezenský potok (Řezná) od státní hranice se SRN až k pramenům včetně Čertova jezera – 10 ha. Lov ryb povolen od státní hranice až k soutoku s Pancířským potokem a na pravostranném přítoku na potoce Železném až k železničnímu viaduktu u Špičáku. Ostatní části revíru jsou chovné – lov ryb zakázán.","delka":12,"rozloha":11,"lat":49.140772,"lon":13.233311,"mo_web":"https://www.rybsvaz.cz/mo/-/nyrsko","mo_tel":"602 439 767","mo_mail":"mira.suchan@cmail.cz","doba":[{"od":"2026-10-01","do":"2026-10-31","h":"07:00–19:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Bolen dravý","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Candát obecný","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-11-30","pozn":""},{"d":"Jelec jesen","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Kapr obecný","min":40,"max":70,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lipan podhorní","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-11-30","pozn":""},{"d":"Losos obecný","min":null,"max":null,"hajen"