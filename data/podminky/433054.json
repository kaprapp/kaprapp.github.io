{"c":"433054","n":"ÚHLAVA 7","t":"P","s":"ZČ","o":"Klatovy","url":"433054-uhlava-7","stav":"2026-10-11","popis":"GPS Z: 49°22'10.845\"N, 13°14'9.44\"E, K: 49°18'45.95\"N, 13°9'2.076\"E\nPřítok Radbuzy. Od jezu v Dolní Lhotě (ř. km 70,9) až k velkému jezu pod Bystřicí (jez u počátku Hartlova mlýna – ř. km 85,6). Přítoky Granádka a Janovický náhon jsou chovné – lov ryb zakázán. Do revíru nepatří Chodská Úhlava (ř. km 83,9), Andělice a Jelenka (ř. km 75,9).","delka":14,"rozloha":9,"lat":49.341222,"lon":13.193267,"mo_web":"https://www.rybsvaz.cz/mo/-/klatovy","mo_tel":"603 715 054","mo_mail":"rybari.kt@tiscali.cz","doba":[{"od":"2026-10-01","do":"2026-10-31","h":"07:00–19:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Bolen dravý","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Candát obecný","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-11-30","pozn":""},{"d":"Jelec jesen","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Kapr obecný","min":40,"max":70,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lipan podhorní","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-11-30","pozn":""},{"d":"Losos obecný","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Mník jednovousý