{"c":"433076","n":"HOŘIMA 1","t":"P","s":"ZČ","o":"Stod","url":"433076-horima-1","stav":"2026-10-05","popis":"GPS Z: 49°37'37.397\"N, 13°6'33.319\"E, K: 49°37'50.065\"N, 13°1'57.774\"E\nPřítok Radbuzy. Od soutoku s Radbuzou (ř. km 41,3) až k pramenům. Od mostu v Hradišťanech až k pramenům je potok chovný – lov ryb zakázán. Součástí revíru je Nedražický potok (GPS Z: 49°37'42.22\"N, 13°4'36.251\"E, K: 49°39'23.066\"N, 13°2'6.994\"E). Ostatní přítoky jsou chovné – lov ryb zakázán. Na revíru je zakázáno brodění. Lov na mrtvou rybku povolen.","delka":12,"rozloha":2,"lat":49.640489,"lon":13.070986,"mo_web":"https://www.rybsvaz.cz/mo/-/stod","mo_tel":"606 7659 067","mo_mail":"crsstod@email.cz","doba":[{"od":"2026-10-01","do":"2026-10-31","h":"07:00–19:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Bolen dravý","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Candát obecný","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-11-30","pozn":""},{"d":"Jelec jesen","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Kapr obecný","min":40,"max":70,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lipan podhorní","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-11-30","pozn":""},{"d":"Losos obecný","min":null,"max":null,"h