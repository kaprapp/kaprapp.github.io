{"c":"443009","n":"DOBRANOVSKÝ POTOK 1","t":"P","s":"SČ","o":"Nový Bor","url":"443009-dobranovsky-potok-1","stav":"2026-10-06","popis":"Přítok Ploučnice. Od ústí do Ploučnice pod Dobranovem až k pramenům. Od vtoku do Radvaneckého rybníka ve Sloupu až k pramenům a přítoky jsou chovné – lov ryb zakázán. Úsek od silničního mostu pod Skalním hradem ve Sloupu v Čechách ř. km 10,9 až k výpusti Radvaneckého rybníka ř. km 12,8 je chráněná rybí oblast – lov ryb zakázán (dle rozhodnutí OkÚ Česká Lípa č. j. RŽP 5245/02-207/3).\r\nRadvanecký rybník není součástí revíru.","delka":12,"rozloha":3,"lat":50.692856,"lon":14.590239,"mo_web":"https://www.rybsvaz.cz/mo/-/novy-bor","mo_tel":"","mo_mail":"rybkynb@seznam.cz","doba":[{"od":"2026-10-01","do":"2026-10-31","h":"07:00–19:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Bolen dravý","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Candát obecný","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-11-30","pozn":""},{"d":"Jelec jesen","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Jelec tloušť","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Kapr obecný","min":40,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lipan podhorní","min":30,"max":null,"hajen":false,"od":"2026-06-16","do":"2026-11-30","pozn":"Mimo revíry Ohře 8 A a 8 B, kde