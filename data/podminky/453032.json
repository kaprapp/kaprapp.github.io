{"c":"453032","n":"LABE 37 P","t":"P","s":"VČ","o":"Hostinné","url":"453032-labe-37-p","stav":"2026-10-05","popis":"Od jezu v Horním Debrném v ř. km 214,2 až k jezu podniku Technolen v Hostinném – Dobré Mysli v ř. km 222,3. Od jímání vody závodem KRPA po odtok z náhonu Labský mlýn je chráněná rybí oblast, vyhlášená KÚ Hradec Králové. Potoky Pilníkovský, Kalenský a Čistá do revíru nepatří – tvoří samostatné revíry. Přítoky jsou chovné – lov ryb zakázán.","delka":8,"rozloha":12,"lat":50.521703,"lon":15.728661,"mo_web":"https://www.rybsvaz.cz/mo/-/hostinne","mo_tel":"+420 603 264 908","mo_mail":"info@crshostinne.cz","doba":[{"od":"2026-10-01","do":"2026-10-31","h":"07:00–19:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":70,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Bolen dravý","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Candát obecný","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-11-30","pozn":""},{"d":"Jelec jesen","min":25,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Jelec tloušť","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Kapr obecný","min":40,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lipan podhorní","min":40,"max":null,"hajen":false,"od":"2026-09-01","do":"2026-11-30","pozn":""},{"d":"Losos obecný","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Mník jednov