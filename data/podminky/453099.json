{"c":"453099","n":"MALÁ ÚPA 1","t":"P","s":"VČ","o":"Horní Maršov","url":"453099-mala-upa-1","stav":"2026-10-03","popis":"Od soutoku s Velkou Úpou až k ústí přítoku Černý potok. Přítoky a úsek od soutoku s Černým potokem až k pramenům jsou chovné – lov ryb zakázán. Zákaz lovu ryb z opěrných zdí. **Lov ryb povolen od 16. 4. do 31. 8.**","delka":10,"rozloha":5,"lat":50.700536,"lon":15.800522,"mo_web":"https://www.rybsvaz.cz/mo/-/horni-marsov","mo_tel":"602 205 279","mo_mail":"pytlak@centrum.cz","doba":[{"od":"2026-10-01","do":"2026-10-31","h":"07:00–19:00","zakaz":false}],"kratkodobe":[],"miry":[{"d":"Amur bílý","min":70,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Bolen dravý","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Candát obecný","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-11-30","pozn":""},{"d":"Jelec jesen","min":25,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Jelec tloušť","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Kapr obecný","min":40,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lín obecný","min":20,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lipan podhorní","min":40,"max":null,"hajen":false,"od":"2026-09-01","do":"2026-11-30","pozn":""},{"d":"Losos obecný","min":null,"max":null,"hajen":true,"od":"2026-01-01","do":"2026-12-31","pozn":""},{"d":"Mník jednovousý","min":30,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Okoun říční","min":null,"max":