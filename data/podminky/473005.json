{"c":"473005","n":"BEČVA VSETÍNSKÁ 3","t":"P","s":"MS","o":"Vsetín","url":"473005-becva-vsetinska-3","stav":"2026-10-10","popis":"GPS Z: 49°19'28.692\"N, 17°59'48.081\"E, K: 49°19'32.139\"N, 18°9'46.821\"E\nPřítok Bečvy, Moravy. Od jezu ve Vsetíně až k jezu v Halenkově včetně všech přítoků, mimo Senici. K revíru nepatří nádrž v Huslenkách.\nVšechny přítoky včetně náhonu od splavu na Hovězí po soutok s Hořanským potokem jsou chovné – lov ryb zakázán.\nOd 1. 9. je lov povolen pouze na hlavním toku. Nejmenší lovná míra pstruha obecného je zvýšena na 30 cm.","delka":11,"rozloha":11,"lat":49.317447,"lon":18.083539,"mo_web":"https://www.rybsvaz.cz/mo/-/vsetin","mo_tel":"604 694 304","mo_mail":"vsetin@mocrs.cz","doba":[{"od":"2026-10-01","do":"2026-10-31","h":"07:00–19:00","zakaz":false}],"kratkodobe":[{"od":"2026-08-14","do":"2026-12-31","duvod":"Na revíru platí zákaz rybolovu od 14.8.2026 do odvolání z důvodu mimořádného poklesu stavu vodní hladiny způsobené suchem."}],"miry":[{"d":"Amur bílý","min":50,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Bolen dravý","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Candát obecný","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Cejn velký","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Hlavatka obecná","min":65,"max":null,"hajen":false,"od":"2026-10-01","do":"2026-11-30","pozn":""},{"d":"Jelec jesen","min":25,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Jelec tloušť","min":null,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":"povinnost ponechat si"},{"d":"Jeseter malý","min":30,"max":null,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Kapr obecný","min":40,"max":70,"hajen":false,"od":"2026-04-16","do":"2026-11-30","pozn":""},{"d":"Lín obecný","min":25,"max":null,"hajen":false,"od":"20